# Copy to .env (git-ignored). Never commit real keys.
# OpenClaw stores its own provider key during `openclaw onboard`; this file is for the lab tooling.
LLM_PROVIDER=anthropic
LLM_API_KEY=
JUDGE_API_KEY=
SPLUNK_HEC_TOKEN=

# Lab tooling
# HMAC key for signed agent-to-agent handoffs. Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
DCLAB_A2A_KEY=
# Bearer token for the local dashboard. Generate the same way.
DCLAB_DASH_TOKEN=
# Absolute path to the sanitized workspace the agents may read (defaults to ./workspace)
DCLAB_WORKSPACE=
